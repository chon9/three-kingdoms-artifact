 {"name": "rq_44_selemene_sees_its_own_play: playing Incarnation of Selemene refills the Mana it cost", "clause": 0, "tags": ["edge", "RQ-44", "after_you_play"], "board": {"lanes": {"0": {"p0": ["jmuy#j", null], "p1": ["melee_creep#m", null]}}}, "do": [{"play": "incarnation_of_selemene", "position": 1, "as": "s"}], "expect": {"s.in_play": true, "mana.0.0": 10}},
