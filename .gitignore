.godot/
.tools/
builds/
*.log
*.tmp
replays/
# GodotSteam (addons/godotsteam/) is committed for Windows x64, Linux x64 and
# macOS (universal). Other platform builds from the same release stay local.
addons/godotsteam/win32/
addons/godotsteam/linux32/
addons/godotsteam/linuxarm64/
steam_appid.txt
assets/classic_cards/*.png
assets/classic_cards/*.png.import
.playwright-mcp/

# Generated by the Godot CSV translation importer from i18n/ui.csv
i18n/*.translation

# Reserve hero art not used by the game yet (1024x1536 masters still being
# generated). Run tools/optimize_art.py on it before referencing it.
assets/art/heroes_reserve/
